rules_version = '2';

// 這是一個沒有登入機制的內部小工具，因此開放 orders collection 讀寫。
// 若要上線給不特定人使用，請改為要求登入（request.auth != null）或加上其他驗證。
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                      ['customerName', 'mealId', 'drinkId', 'note', 'total', 'createdAt']
                    )
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0
                    && request.resource.data.customerName.size() <= 20
                    && request.resource.data.mealId is string
                    && request.resource.data.drinkId is string
                    && request.resource.data.note.size() <= 100
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;

      allow delete: if true;
      allow update: if false;
    }
  }
}
